# Copy to .env.local and fill in. .env.local is git-ignored.

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Postgres — SESSION pooler (:5432, IPv4-safe) for drizzle-kit, migrations and scripts.
DATABASE_URL=
# Postgres — TRANSACTION pooler (:6543) for the Next.js runtime (prepare:false).
POOL_DATABASE_URL=

# ── Admin allowlist — ONLY these emails can access /admin and write to the
#    media bucket (comma-separated). Re-run `npm run db:policies` after changing.
#    Authentication alone is NOT enough; an empty allowlist authorizes nobody. ──
ADMIN_EMAILS=

# ── Admin account provisioned by `npm run admin:create`. Leave ADMIN_PASSWORD
#    blank to have a strong one generated and appended to .env.local. ──
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional: canonical site URL for metadata (defaults to Vercel URL / localhost).
NEXT_PUBLIC_SITE_URL=
